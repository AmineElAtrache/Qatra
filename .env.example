# Copy to .env and fill in. Never commit .env.

# --- Backend ---
DATABASE_URL=postgresql+psycopg://qatra:qatra@localhost:5432/qatra
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-in-real-deploy
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ENGINE_VERSION=0.1.0
CORS_ORIGINS=http://localhost:3000

# --- Satellite (Copernicus Data Space) ---
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
# Optional: Google Earth Engine for eligible non-commercial research.
# Backend uses ADC/service-account credentials; it never starts interactive auth.
GEE_PROJECT_ID=
GEE_CREDENTIALS_PATH=

# --- Weather ---
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# --- Explanation (Ollama local) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
KNOWLEDGE_DIR=knowledge

# --- Speech (Piper / Web Speech) ---
PIPER_MODEL_PATH=
SPEECH_BACKEND=webspeech

# --- Notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
NOTIFICATION_CHANNEL=web

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8000
